            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">The namespace of this schema is:</fo:block>
            <fo:block space-before.minimum="0.8em"
                      space-before.optimum="1em"
                      space-before.maximum="1.2em"
                      space-after.minimum="0.8em"
                      space-after.optimum="1em"
                      space-after.maximum="1.2em"
                      hyphenate="false"
                      wrap-option="no-wrap"
                      white-space-collapse="false"
                      white-space-treatment="preserve"
                      linefeed-treatment="preserve"
                      text-align="start"
                      font-family="ProductusOSGiMonoc,ArialUnicodeMS"
                      font-size="9pt"
                      letter-spacing="-.0em"
                      space-before="5pt"
                      space-after="3pt"
                      space-after.conditionality="retain"
                      start-indent="inherit"
                      line-height="11pt"
                      id="d61e853">http://www.osgi.org/xmlns/repository/v1.0.0</fo:block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">The schema for this namespace can be found at the location implied
    in its name. The recommended prefix for this namespace is
    <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                          font-size="9pt"
                          letter-spacing="0.08em">repo</fo:inline>.</fo:block>
            <fo:block space-before.minimum="0.8em"
                      space-before.optimum="1em"
                      space-before.maximum="1.2em"
                      space-after.minimum="0.8em"
                      space-after.optimum="1em"
                      space-after.maximum="1.2em"
                      hyphenate="false"
                      wrap-option="no-wrap"
                      white-space-collapse="false"
                      white-space-treatment="preserve"
                      linefeed-treatment="preserve"
                      text-align="start"
                      font-family="ProductusOSGiMonoc,ArialUnicodeMS"
                      font-size="7pt"
                      letter-spacing="-.0em"
                      space-before="5pt"
                      space-after="3pt"
                      space-after.conditionality="retain"
                      start-indent="0pt"
                      line-height="8pt"
                      id="d61e858">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;!--
