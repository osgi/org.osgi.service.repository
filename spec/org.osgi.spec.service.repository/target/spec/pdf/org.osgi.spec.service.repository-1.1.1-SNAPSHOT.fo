                      width="100%">
               <fo:table-column column-number="1" column-width="proportional-column-width(0)"/>
               <fo:table-column column-number="2" column-width="proportional-column-width(0)"/>
               <fo:table-column column-number="3" column-width="proportional-column-width(1)"/>
               <fo:table-body>
                  <fo:table-row block-progression-dimension.minimum="9pt">
                     <fo:table-cell text-align="start" display-align="before" relative-align="baseline">
                        <fo:block text-align-last="justify">
                           <fo:block/>
                        </fo:block>
                     </fo:table-cell>
                     <fo:table-cell text-align="center"
                                    display-align="before"
                                    relative-align="baseline">
                        <fo:block>
                           <fo:block/>
                        </fo:block>
                     </fo:table-cell>
                     <fo:table-cell text-align="right" display-align="before" relative-align="baseline">
                        <fo:block text-align-last="justify">
                           <fo:block>
                              <fo:retrieve-marker retrieve-class-name="section.head.marker"
                                                  retrieve-position="first-including-carryover"
                                                  retrieve-boundary="page-sequence"/>
                              <fo:leader leader-pattern="space"/>Repository Service Specification <fo:basic-link internal-destination="org.osgi.service.repository">
                                 <fo:inline color="inherit"
                                            font-family="inherit"
                                            letter-spacing="inherit"
                                            hyphenate="inherit">Version 1.1</fo:inline>
                              </fo:basic-link>
                           </fo:block>
