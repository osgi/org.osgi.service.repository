                  </fo:block>
               </fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">
An {@code ExpressionCombiner} can be used to combine requirement expressions
 into a single complex requirement expression using the {@code and},
 {@code or} and {@code not} operators.
   </fo:block>
               <fo:block xmlns:d="http://docbook.org/ns/docbook"
                         xmlns:xlink="http://www.w3.org/1999/xlink"
                         space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt"
                         start-indent="0pt"
                         relative-align="baseline">
                  <fo:list-block provisional-distance-between-starts="1in"
                                 provisional-label-separation="0.090in">
                     <fo:list-item>
                        <fo:list-item-label end-indent="label-end()" text-align="start">
                           <fo:block text-align="end" font-style="italic">
                              <fo:block>Since</fo:block>
                           </fo:block>
                        </fo:list-item-label>
                        <fo:list-item-body start-indent="body-start()">
                           <fo:block>@since 1.1</fo:block>
                        </fo:list-item-body>
                     </fo:list-item>
                  </fo:list-block>
               </fo:block>
               <fo:block xmlns:d="http://docbook.org/ns/docbook"
                         xmlns:xlink="http://www.w3.org/1999/xlink"
                         space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt"
                         start-indent="0pt"
                         relative-align="baseline">
                  <fo:list-block provisional-distance-between-starts="1in"
                                 provisional-label-separation="0.090in">
                     <fo:list-item>
                        <fo:list-item-label end-indent="label-end()" text-align="start">
                           <fo:block text-align="end" font-style="italic">
                              <fo:block>Concurrency</fo:block>
                           </fo:block>
                        </fo:list-item-label>
                        <fo:list-item-body start-indent="body-start()">
                           <fo:block>Thread-safe </fo:block>
                        </fo:list-item-body>
                     </fo:list-item>
                  </fo:list-block>
               </fo:block>
               <fo:block xmlns:d="http://docbook.org/ns/docbook"
                         xmlns:xlink="http://www.w3.org/1999/xlink"
                         space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt"
                         start-indent="0pt"
                         relative-align="baseline">
                  <fo:list-block provisional-distance-between-starts="1in"
                                 provisional-label-separation="0.090in">
                     <fo:list-item>
                        <fo:list-item-label end-indent="label-end()" text-align="start">
                           <fo:block text-align="end" font-style="italic">
                              <fo:block>Provider Type</fo:block>
                           </fo:block>
                        </fo:list-item-label>
                        <fo:list-item-body start-indent="body-start()">
                           <fo:block>Consumers of this API must not implement this type</fo:block>
